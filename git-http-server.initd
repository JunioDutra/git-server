#!/sbin/openrc-run

name="git-http-server"
description="Git HTTP server (create/browse/delete repos)"
command="/usr/bin/python3"
command_args="/opt/git-http-server/app.py"
command_user="git"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/opt/git-http-server/server.log"
error_log="/opt/git-http-server/server.log"

depend() {
    need net
    after firewall
}

start_pre() {
    local missing=""
    local var value
    for var in GIT_HTTP_HOST GIT_HTTP_PORT GIT_SSH_HOST GIT_DEFAULT_BRANCH; do
        eval "value=\${$var:-}"
        [ -n "$value" ] || missing="$missing $var"
    done
    if [ -n "$missing" ]; then
        eerror "Missing required environment variables:$missing"
        return 1
    fi
    checkpath -d -o git:git /opt/git-http-server
    checkpath -d -m 0700 -o git:git "${GIT_REPOSITORY_ENV_ROOT:-/home/git/repository-env}"
    checkpath -f -o git:git /opt/git-http-server/server.log
}
