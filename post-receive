#!/bin/sh
# post-receive hook (canonical, ADR-0002-D1/D2 + ADR-0003-D2/D4)
# Dispatcher: reads pushed refs from stdin (old new ref) and triggers
#   - isolated build submission via build_submit.py and the OpenRC dispatcher
#   - mirror sync (ADR-0003)      via mirror-sync.sh
# Build submission is a short local socket operation; execution stays detached
# inside the dispatcher, so the push never waits for BuildKit or the registry.
#
# Installed at /home/git/hooks/post-receive and symlinked/templated into
# every bare repo. This is the ONLY canonical copy.
#
# Format of stdin (git): <oldrev> <newrev> <refname>
# Builds only for refs/heads/* pushes; deletions are ignored for build.
# Mirror sync handles both pushes and deletions (refs/heads/*).

set -u

# Resolve the CANONICAL hook dir even when invoked via a symlink
# (e.g. /home/git/repos/<name>.git/hooks/post-receive -> /home/git/hooks/post-receive).
# Using readlink -f ensures $0 resolves to the real canonical path, so
# $HOOK_DIR points at /home/git/hooks and the canonical scripts are used.
# (Without this, dirname $0 returned the symlink dir, so the hook used
# stale per-repo copies of build_submit.py/mirror-sync.sh instead of the
# canonical ones — causing mirror sync to fail only on real SSH pushes.)
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
HOOK_DIR="$(cd "$(dirname "$SELF")" && pwd)"
GIT_DIR_REPO="$(pwd)"          # bare repo dir (hooks run with cwd = repo)

# Canonical scripts live next to this hook
BUILD_SUBMIT="$HOOK_DIR/build_submit.py"
MIRROR_SCRIPT="$HOOK_DIR/mirror-sync.sh"
HOOK_LOGS_ROOT="${GIT_HOOK_LOGS_ROOT:-/home/git/logs/hooks}"
HOOK_LOG_RETENTION_DAYS="${GIT_HOOK_LOG_RETENTION_DAYS:-30}"

# Resolve repo name from bare dir path (e.g. /home/git/repos/foo.git -> foo)
REPO_NAME=$(basename "$GIT_DIR_REPO" .git)

REPO_LOG_DIR="$HOOK_LOGS_ROOT/$REPO_NAME"
mkdir -p "$REPO_LOG_DIR"

# Best-effort retention. The HTTP server also performs this cleanup hourly.
case "$HOOK_LOG_RETENTION_DAYS" in
  ''|*[!0-9]*) HOOK_LOG_RETENTION_DAYS=30 ;;
esac
find "$REPO_LOG_DIR" -type f -name '*.log' -mtime +"$HOOK_LOG_RETENTION_DAYS" -delete 2>/dev/null || true

write_build_queue_error() {
  branch=$1
  sha=$2
  code=$3
  message=$4
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  tmp=$(mktemp "$REPO_LOG_DIR/${stamp}-build-dispatcher-XXXXXX") || return 1
  log_file="$tmp.log"
  mv "$tmp" "$log_file" || return 1
  {
    printf '%s\n' "# hook-log: type=build-dispatcher"
    printf '%s\n' "# hook-log: repo=$REPO_NAME"
    printf '%s\n' "# hook-log: started_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '%s\n' "# hook-log: branch=$branch"
    printf '%s\n' "# hook-log: sha=$sha"
    printf '%s\n' "# hook-log: --- output ---"
    printf '%s\n' "$message"
    printf '%s\n' "# hook-log: ended_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '%s\n' "# hook-log: exit=$code"
  } > "$log_file" 2>&1
}

queue_build() {
  branch=$1
  sha=$2
  if [ ! -x "$BUILD_SUBMIT" ]; then
    write_build_queue_error "$branch" "$sha" 127 \
      "build submit client not found or not executable: $BUILD_SUBMIT"
    return 1
  fi
  error=$("$BUILD_SUBMIT" "$branch" "$sha" "$REPO_NAME" 2>&1) && return 0
  code=$?
  write_build_queue_error "$branch" "$sha" "$code" "$error"
  return 1
}

run_mirror_logged() {
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  tmp=$(mktemp "$REPO_LOG_DIR/${stamp}-mirror-XXXXXX") || return 1
  log_file="$tmp.log"
  mv "$tmp" "$log_file" || return 1
  (
    printf '%s\n' "# hook-log: type=mirror"
    printf '%s\n' "# hook-log: repo=$REPO_NAME"
    printf '%s\n' "# hook-log: started_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '%s\n' "# hook-log: refs=$*"
    printf '%s\n' "# hook-log: --- output ---"
    if [ -x "$MIRROR_SCRIPT" ]; then
      "$MIRROR_SCRIPT" "$GIT_DIR_REPO" "$REPO_NAME" "$@"
      code=$?
    else
      echo "mirror script not found or not executable: $MIRROR_SCRIPT" >&2
      code=127
    fi
    printf '%s\n' "# hook-log: ended_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '%s\n' "# hook-log: exit=$code"
    exit "$code"
  ) > "$log_file" 2>&1 &
}

# Collect refs for mirror sync (newrev:ref pairs; only refs/heads/*)
MIRROR_PAIRS=""
# Build triggers (branch sha)
BUILD_SPECS=""

# Process each ref line
while read -r oldrev newrev ref; do
  [ -z "$ref" ] && continue
  case "$ref" in
    refs/heads/*)
      BRANCH=${ref#refs/heads/}
      SHA=$newrev
      SHORT_SHA=$(printf '%s' "$SHA" | cut -c1-12)

      # Deletion (newrev all zeros) -> nothing to build, mirror as delete
      case "$newrev" in
        0000000000000000000000000000000000000000)
          MIRROR_PAIRS="$MIRROR_PAIRS $newrev:$ref"
          continue
          ;;
      esac

      MIRROR_PAIRS="$MIRROR_PAIRS $newrev:$ref"
      BUILD_SPECS="$BUILD_SPECS $BRANCH:$SHA:$REPO_NAME"
      ;;
  esac
done

# Queue isolated builds (ADR-0002/ADR-0004/ADR-0005)
if [ -n "$BUILD_SPECS" ]; then
  for spec in $BUILD_SPECS; do
    BRANCH=${spec%%:*}
    rest=${spec#*:}
    SHA=${rest%%:*}
    SHORT_SHA=$(printf '%s' "$SHA" | cut -c1-12)
    if queue_build "$BRANCH" "$SHA"; then
      echo "[git-server] queued pipeline for $REPO_NAME@$BRANCH ($SHORT_SHA)" >&2
    else
      echo "[git-server] failed to queue build for $REPO_NAME@$BRANCH ($SHORT_SHA)" >&2
    fi
  done
fi

# Async: mirror sync (ADR-0003)
if [ -n "$MIRROR_PAIRS" ]; then
  # Intentional unquoted expansion: each collected newrev:ref pair is one argument.
  run_mirror_logged $MIRROR_PAIRS || echo "[git-server] failed to create mirror log" >&2
  echo "[git-server] queued mirror sync for $REPO_NAME" >&2
fi

exit 0
